# Copia este archivo a .env y ajusta los valores.
# .env NO se versiona (está en .gitignore).

# ------------------------------------------------------------
# Clave de firma de las cookies de sesión — OBLIGATORIA
# Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
SECRET_KEY=cambia-esto-por-un-valor-aleatorio

# ------------------------------------------------------------
# Base de datos
# Sin definir  -> SQLite local en instance/sicof.db (desarrollo)
# PostgreSQL centralizado:
#   DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/sicof
# ------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg2://sicof:clave@servidor.soapap.local:5432/sicof

# ------------------------------------------------------------
# Modo debug: 1 solo en desarrollo.
# En producción DEBE quedar en 0: el depurador de Werkzeug permite
# ejecutar código arbitrario desde el navegador.
# ------------------------------------------------------------
FLASK_DEBUG=1

# ------------------------------------------------------------
# Contraseña del superadmin que crea 'flask init-db'.
# Solo se usa al sembrar la base; después se cambia desde la aplicación.
# ------------------------------------------------------------
SICOF_ADMIN_PASSWORD=cambia-esta-clave

# ------------------------------------------------------------
# Año en que rige el consecutivo global de folios.
# ------------------------------------------------------------
ANIO_CONSECUTIVO_GLOBAL=2026

# ------------------------------------------------------------
# Generación automática semanal de folios reservados (domingos 23:00).
# Es un hilo dentro del proceso web: con varios workers se duplicaría.
# En producción va en 0 y lo dispara sicof-reservados.timer, que ejecuta
# `flask generar-reservados`.
# ------------------------------------------------------------
FOLIOS_RESERVADOS_AUTO=0

# ============================================================
#   SOLO PRODUCCIÓN (detrás de nginx y del proxy corporativo)
# ============================================================

# Saltos de proxy de confianza delante de la aplicación.
# 0 = sin proxy (desarrollo). 2 = nginx local + proxy corporativo.
# Activarlo sin proxy delante permitiría falsear las cabeceras X-Forwarded-*.
# PROXY_SALTOS=2

# Marca la cookie de sesión como Secure. Ponlo en 1 cuando el navegador
# llegue por HTTPS, aunque hasta nginx el tramo interno vaya en claro.
# SESSION_COOKIE_SECURE=1

# Tamaño máximo de subida en MB para el importador de Excel.
# Debe coincidir con client_max_body_size de nginx.
# MAX_UPLOAD_MB=20
